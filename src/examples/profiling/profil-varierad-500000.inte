let visits = 0;
function add(left, right) {
    return left + right;
}
function subtract(left, right) {
    return left - right;
}
function magnitude(value) {
    if (value < 0) {
        return -value;
    }
    return value;
}
function clamp(value, maximum) {
    if (value < 0) {
        return 0;
    } else if (value > maximum) {
        return maximum;
    } else {
        return value;
    }
}
function sumTo(value) {
    let total = 0;
    while (value > 0) {
        total = total + value;
        value = value - 1;
    }
    return total;
}
function label(value) {
    if (value == 0) {
        return "noll";
    } else if (value > 0) {
        return "positiv";
    } else {
        return "negativ";
    }
}
function triangular(value) {
    if (value <= 0) {
        return 0;
    }
    return value + triangular(value - 1);
}
function register(value) {
    visits = visits + 1;
    return value;
}
