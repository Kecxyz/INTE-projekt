    text = "kod-115-" + value;
    if (text != "") {
        total = total + 1;
    }
    value = triangular(8);
    other = sumTo(13);
    total = total + (value + other);
    flag = (18 - 9) >= (-6);
    if (flag) {
        total = total + add(18, 9);
    } else {
        total = total + subtract(9, 18);
    }
    count = 0;
    value = 0;
    while (count < 56) {
        value = add(value, clamp(count, 8));
        count = count + 1;
    }
    total = total + value;
    register(3);
    value = register(11);
    total = total + value;
    text = "anrop-" + 3;
    if (text < "z") {
        total = total + 1;
    }
    value = (4 + 12) - (2 - 4);
    other = -(4 + 2) + 12;
    total = total + (value - other);
    total = total + (4 - (12 - 2));
    value = 5 - 5;
    if (value > 0) {
        total = total + value;
    } else if (value == 0) {
        total = total + 2;
    } else {
        total = total - value;
    }
    value = 60;
    count = 0;
    while (value > 0) {
        count = count + value;
        value = value - 1;
    }
    total = total + count;
    count = 0;
    value = 0;
    while (count < 7) {
        inner = 0;
        while (inner < 7) {
            if (inner < count) {
                value = value + 2;
            } else {
                value = value + 1;
            }
            inner = inner + 1;
        }
        count = count + 1;
    }
    total = total + value;
    value = add(8, subtract(5, 8));
    other = magnitude(-8);
    value = clamp(value - other, 8);
    total = total + value;
    value = 9 - 8;
    text = label(value);
    if (text == "positiv") {
        total = total + 3;
    } else if (text == "noll") {
        total = total + 2;
    } else {
        total = total + 1;
    }
    text = "kod-125-" + value;
    if (text != "") {
        total = total + 1;
    }
    return total;
}
let result = run();
print("Resultat: " + (result + visits));
